# Sao chép thành .env rồi điền khoá thật. KHÔNG commit file .env.
# ---------- Ollama Cloud ----------
# Tạo API key tại https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Truy cập TRỰC TIẾP API ollama.com: host https://ollama.com và tên model KHÔNG có hậu tố "-cloud" (gpt-oss:120b).
# Tên "gpt-oss:120b-cloud" chỉ dùng khi đi qua Ollama cài trên máy (ollama signin) -> OLLAMA_HOST=http://localhost:11434.
# Hệ thống tự bỏ hậu tố "-cloud" khi OLLAMA_HOST là https://ollama.com.
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# Với Ollama cục bộ: câu hỏi thường dùng prompt/context ngắn; yêu cầu kể chuyện/chi tiết có ngân sách lớn hơn.
LOCAL_FAST_MODE=true
# Cache trong bộ nhớ (giây), chỉ câu hỏi độc lập có nguồn và không bị cảnh báo; 0 để tắt.
CHAT_CACHE_TTL_S=600
# ---------- ElevenLabs ----------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Gói Free không dùng được Voice Library qua API -> dùng giọng premade. Đặt voice_id riêng cho từng ngôn ngữ nếu muốn.
ELEVENLABS_VOICE_VI=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_EN=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ZH=JBFqnCBsd6RMkjVDRZzb
TTS_CHUNK_CHARS=900
# ---------- Ứng dụng ----------
DATABASE_URL=sqlite:///../data/museum.db
CORS_ORIGINS=http://localhost:5173
MAX_REQUEST_BYTES=20000
MAX_MESSAGE_CHARS=800
RETRIEVAL_TOP_K=6
# tfidf = luôn chạy được (offline); sbert = dense multilingual (cần cài sentence-transformers + Internet lần đầu)
EMBEDDING_BACKEND=tfidf
EMBEDDING_MODEL=intfloat/multilingual-e5-small
AUDIO_CACHE_DIR=../data/audio_cache
